{
  "definition": {
    "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
    "contentVersion": "1.0.0.0",
    "triggers": {
      "When_a_HTTP_request_is_received": {
        "type": "Request",
        "kind": "Http",
        "description": "Summarises sales from the data warehouse (total sales amount, quantity and order count) grouped by order year, customer country or product category, with optional filters.",
        "inputs": {
          "method": "POST",
          "schema": {
            "type": "object",
            "properties": {
              "group_by": {
                "type": "string",
                "enum": [
                  "year",
                  "country",
                  "category"
                ],
                "description": "How to group the totals: 'year' (order year), 'country' (customer country) or 'category' (product category). Defaults to 'year'."
              },
              "year": {
                "type": "integer",
                "description": "Order year to filter on, for example 2013. Omit or use 0 for all years."
              },
              "country": {
                "type": "string",
                "description": "Customer country to filter on, for example 'Germany' or 'United States'. Omit for all countries."
              },
              "category": {
                "type": "string",
                "description": "Product category to filter on, for example 'Bikes', 'Components', 'Clothing' or 'Accessories'. Omit for all categories."
              }
            },
            "required": [
              "group_by"
            ]
          }
        }
      }
    },
    "actions": {
      "Execute_stored_procedure": {
        "type": "ApiConnection",
        "inputs": {
          "host": {
            "connection": {
              "referenceName": "sql"
            }
          },
          "method": "post",
          "body": {
            "group_by": "@{coalesce(triggerBody()?['group_by'], 'year')}",
            "year": "@coalesce(triggerBody()?['year'], 0)",
            "country": "@{coalesce(triggerBody()?['country'], '')}",
            "category": "@{coalesce(triggerBody()?['category'], '')}"
          },
          "path": "/v2/datasets/@{encodeURIComponent(encodeURIComponent('default'))},@{encodeURIComponent(encodeURIComponent('default'))}/procedures/@{encodeURIComponent(encodeURIComponent('[gold].[usp_get_sales_summary]'))}"
        },
        "runAfter": {}
      },
      "Response_success": {
        "type": "Response",
        "kind": "Http",
        "inputs": {
          "statusCode": 200,
          "headers": {
            "Content-Type": "application/json"
          },
          "body": "@coalesce(body('Execute_stored_procedure')?['ResultSets']?['Table1'], json('[]'))"
        },
        "runAfter": {
          "Execute_stored_procedure": [
            "Succeeded"
          ]
        }
      },
      "Response_error": {
        "type": "Response",
        "kind": "Http",
        "inputs": {
          "statusCode": 500,
          "headers": {
            "Content-Type": "application/json"
          },
          "body": {
            "error": "@{coalesce(body('Execute_stored_procedure')?['message'], 'The warehouse query failed.')}"
          }
        },
        "runAfter": {
          "Execute_stored_procedure": [
            "Failed",
            "TimedOut"
          ]
        }
      }
    },
    "outputs": {}
  },
  "kind": "Stateful"
}
